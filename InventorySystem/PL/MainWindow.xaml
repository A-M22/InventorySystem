<Window x:Class="InventorySystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventorySystem"
        xmlns:vm="clr-namespace:InventorySystem.PL.ViewModels"
        xmlns:views="clr-namespace:InventorySystem.PL.View"
        mc:Ignorable="d"
        Title="Inventory System" Height="1080"
        Width="1920"
        >
    

    

        <Window.Resources>

            <DataTemplate
            DataType="{x:Type vm:ItemCodeViewModel}">

                <views:ItemCodeView/>

            </DataTemplate>

        </Window.Resources>


        <ContentControl
           Content="{Binding CurrentView}"/>
           

   
</Window>
